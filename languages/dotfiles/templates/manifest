#!/bin/bash

# Sourced, never run. The one list of files that belong to the tooling rather
# than to the dotfiles themselves: install skips them when linking into $HOME,
# and repokit's setup copies them in. Both read it from here so the two lists
# cannot drift apart.
#
# A space-separated string, not an array: bash cannot export an array, and
# this file is sourced into more than one script. Which of them are executable
# is not listed here — each template carries its own mode.
export DOTFILES_TOOLING="adopt commit install restart uninstall watch manifest watch.plist"
