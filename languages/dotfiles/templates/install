#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

# shellcheck source=manifest
source "$SCRIPT_DIR/manifest"

# The tooling files live in this repo but must not be linked into $HOME.
# read -ra splits the manifest's space-separated list into an array.
read -ra tooling <<< "$DOTFILES_TOOLING"
excludes=()
for name in "${tooling[@]}"; do
  excludes+=(! -name "$name")
done

find "$SCRIPT_DIR" -type f \
  ! -path '*/.git/*' \
  ! -path '*/_claude/*' \
  "${excludes[@]}" \
  ! -name '*.md' |
  while read -r src; do
    rel="${src#"$SCRIPT_DIR"/}"
    dest="$HOME/$rel"
    if [[ -e "$dest" && ! -L "$dest" ]]; then
      echo "SKIP (exists): ~/$rel" >&2
    else
      mkdir -p "$(dirname "$dest")"
      ln -sf "$src" "$dest"
      echo "linked: ~/$rel"
    fi
  done

LABEL="com.$(whoami).$(basename "$SCRIPT_DIR")-watch"
PLIST="$HOME/Library/LaunchAgents/$LABEL.plist"

# The plist is a template next to this script; the two placeholders are filled
# with bash's own substitution, so no sed and nothing outside the shell.
# $(< file) reads the file; ${var//pattern/replacement} replaces every match.
plist=$(< "$SCRIPT_DIR/watch.plist")
plist=${plist//\{\{LABEL\}\}/$LABEL}
plist=${plist//\{\{SCRIPT_DIR\}\}/$SCRIPT_DIR}
printf '%s\n' "$plist" > "$PLIST"

launchctl load "$PLIST"
echo "installed: $LABEL"
