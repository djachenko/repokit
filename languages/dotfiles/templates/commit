#!/bin/bash
set -e
cd "$(dirname "$0")"

# Commit the working tree as one commit per area, so an automatic run does not
# produce a single opaque "auto: everything" entry.
#
# git calls stay here; deriving the groups, their files and the commit message
# is repokore's job — it used to be four nested awk programs.

# Filled in by repokit when it copies this script: the absolute path of the
# binary from the install that set this repo up. Worked out here it would have
# to guess — launchd runs this with neither repokit on PATH nor XDG_DATA_HOME.
REPOKORE="{{REPOKORE}}"

if [[ ! -x "$REPOKORE" ]]; then
  echo "✗ repokore not found at $REPOKORE — re-run repokit in this repo" >&2
  exit 1
fi

# The status is captured once into a file: every query below has to see the same
# tree, and reading it again after the first `git add` would see a changed one.
STATUS=$(mktemp)
trap 'rm -f "$STATUS"' EXIT

# -z: NUL-separated and unquoted. Without it git wraps any path with non-ASCII
# bytes in quotes and octal escapes, and `git add` cannot find the result.
git status --porcelain -z > "$STATUS"
[[ -s "$STATUS" ]] || exit 0

while IFS= read -r key; do
  # Paths come back NUL-separated for the same reason; read -d '' splits on NUL.
  # -- ends options, so a file named like a flag is still just a file.
  while IFS= read -r -d '' file; do
    git add -- "$file"
  done < <("$REPOKORE" group-changes paths --status "$STATUS" --key "$key")

  # -F - reads the message from stdin, subject and body in one go.
  "$REPOKORE" group-changes message --status "$STATUS" --key "$key" | git commit -F -
done < <("$REPOKORE" group-changes keys --status "$STATUS")
