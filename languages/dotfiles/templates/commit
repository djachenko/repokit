#!/bin/bash
set -e
cd "$(dirname "$0")"

# Commit the working tree as one commit per area, so an automatic run does not
# produce a single opaque "auto: everything" entry.
#
# git calls stay here; deriving the groups, their files and the commit message
# is repokore's job — it used to be four nested awk programs.

REPOKORE="${REPOKORE:-$HOME/.local/share/repokit/bin/repokore}"

if [[ ! -x "$REPOKORE" ]]; then
  echo "✗ repokore not found at $REPOKORE" >&2
  exit 1
fi

# The status is captured once into a file: every query below has to see the same
# tree, and reading it again after the first `git add` would see a changed one.
STATUS=$(mktemp)
trap 'rm -f "$STATUS"' EXIT

git status --porcelain > "$STATUS"
[[ -s "$STATUS" ]] || exit 0

while IFS= read -r key; do
  while IFS= read -r file; do
    git add "$file"
  done < <("$REPOKORE" group-changes paths --status "$STATUS" --key "$key")

  # -F - reads the message from stdin, subject and body in one go.
  "$REPOKORE" group-changes message --status "$STATUS" --key "$key" | git commit -F -
done < <("$REPOKORE" group-changes keys --status "$STATUS")
