#!/usr/bin/env bash
set -euo pipefail

DOTFILES="$(cd "$(dirname "$0")" && pwd)"

[[ $# -eq 1 ]] || {
  echo "Usage: adopt <file>" >&2
  echo "" >&2
  echo "Moves <file> out of \$HOME into $DOTFILES at the same relative path" >&2
  echo "and leaves a symlink where it was, so the file becomes tracked there" >&2
  echo "but is still found by whatever reads it." >&2
  exit 1
}

file="$(cd "$(dirname "$1")" && pwd)/$(basename "$1")"

# The dotfiles repo mirrors the layout of $HOME: a file's place in it is its
# path relative to $HOME. A file elsewhere has no such path — nowhere to put
# it, and nothing to link back to.
[[ "$file" == "$HOME/"* ]] || {
  echo "error: $file is outside \$HOME" >&2
  echo "  $DOTFILES mirrors \$HOME, so only files under \$HOME have a place in it." >&2
  exit 1
}
[[ ! -L "$file" ]] || {
  echo "error: $file is already a symlink — nothing to adopt" >&2
  exit 1
}

rel="${file#"$HOME"/}"
dest="$DOTFILES/$rel"

[[ ! -e "$dest" ]] || {
  echo "error: $dest already exists" >&2
  exit 1
}

mkdir -p "$(dirname "$dest")"
mv "$file" "$dest"
ln -s "$dest" "$file"
echo "adopted: ~/$rel → $dest"
